@model ASC.Web.Areas.Configuration.Models.MasterValuesViewModel
@{
    Layout = "_SecureLayout";
}

<div class="master-page">
    <!-- LIST -->
    <div class="master-card z-depth-1">
        <div class="master-card-header">
            <h5>Master Values</h5>
        </div>

        <div class="master-card-body">
            <div class="row top-tools-row">
                <div class="input-field col s12 m4">
                    <select id="ddlMasterKeys" asp-items="@(new SelectList(ViewBag.MasterKeys, "RowKey", "PartitionKey"))">
                        <option value="">--Select--</option>
                    </select>
                    <label>Partition Key</label>
                </div>

                <div class="col s12 m8 right-align export-zone">
                    <a class="btn-flat modal-trigger" href="#modal1" title="Upload Excel">
                        <i class="material-icons">upload_file</i>
                    </a>
                </div>
            </div>

            <table class="highlight centered" id="tblMasterValues">
                <thead>
                    <tr>
                        <th>Row Key</th>
                        <th>Partition Key</th>
                        <th>Name</th>
                        <th>Is Active</th>
                        <th>Edit</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>

    <!-- DETAILS -->
    <div class="master-card z-depth-1">
        <div class="master-card-header">
            <h5>Master Value Details</h5>
        </div>

        <div class="master-card-body">
            <form asp-controller="MasterData" asp-action="MasterValues" method="post" id="formMasterValue">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="IsEdit" />
                <input type="hidden" asp-for="MasterValueInContext.RowKey" />
                <input type="hidden" asp-for="MasterValueInContext.PartitionKey" />

                <div class="row form-row">
                    <div class="input-field col s12 m4">
                        <input id="Input_MasterValue_RowKey" type="text" disabled />
                        <label for="Input_MasterValue_RowKey" class="active">RowKey</label>
                    </div>

                    <div class="input-field col s12 m4">
                        <select id="Select_MasterValueInContext_PartitionKey"
                                asp-for="MasterValueInContext.PartitionKey"
                                asp-items="@(new SelectList(ViewBag.MasterKeys, "RowKey", "PartitionKey"))"
                                required="required">
                            <option value="">--Select--</option>
                        </select>
                        <label>Partition Key</label>
                    </div>

                    <div class="input-field col s12 m4">
                        <input asp-for="MasterValueInContext.Name" id="MasterValueInContext_Name" />
                        <label asp-for="MasterValueInContext.Name">Name</label>
                    </div>
                </div>

                <div class="row form-row">
                    <div class="col s12 m4 switch-wrap">
                        <span class="switch-text">Is Active</span>
                        <div class="switch">
                            <label>
                                <input asp-for="MasterValueInContext.IsActive" type="checkbox" />
                                <span class="lever"></span>
                            </label>
                        </div>
                    </div>

                    <div class="col s12 m8 right-align">
                        <button class="btn waves-effect waves-light teal btnSubmit" type="button">
                            Create
                            <i class="material-icons right">send</i>
                        </button>

                        <button class="btn waves-effect waves-light red lighten-1 reset" type="button">
                            Reset
                        </button>
                    </div>

                    <div class="col s12 validation-wrap" asp-validation-summary="All"></div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Upload -->
<div id="modal1" class="modal modal-fixed-footer">
    <div class="modal-content">
        <h4>Upload Excel</h4>
        <p>Upload the Excel file that contains all the master values.</p>

        <div class="row hide divErrors">
            <div class="col s12">
                <div class="card-panel red lighten-1">
                    <span class="white-text errors"></span>
                </div>
            </div>
        </div>

        <div class="progress hide">
            <div class="indeterminate"></div>
        </div>

        <form asp-action="UploadExcel" asp-controller="MasterData" method="post">
            @Html.AntiForgeryToken()

            <div class="file-field input-field">
                <div class="btn teal">
                    <span>File</span>
                    <input type="file" id="files">
                </div>
                <div class="file-path-wrapper">
                    <input class="file-path validate" type="text">
                </div>
                <div class="input-field row right">
                    <button class="btn waves-effect waves-light btnUpload" type="button">
                        Upload
                        <i class="material-icons right">send</i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var token = $('input[type=hidden][name=__RequestVerificationToken]', document).val();
            $.ajaxSetup({
                cache: false,
                headers: { 'RequestVerificationToken': token }
            });

            var table = $('#tblMasterValues').DataTable({
                ajax: {
                    url: '@Url.Action("MasterValuesByKey", "MasterData")',
                    type: 'GET'
                },
                pageLength: 3,
                lengthMenu: [[3, 5, 10, -1], [3, 5, 10, 'All']],
                columns: [
                    { data: 'RowKey' },
                    { data: 'PartitionKey' },
                    { data: 'Name' },
                    { data: 'IsActive' },
                    { data: 'Actions' }
                ],
                aoColumnDefs: [
                    {
                        aTargets: [3],
                        mData: "IsActive",
                        mRender: function (data) {
                            if (data === true) {
                                return '<i class="material-icons status-active">check</i>';
                            }
                            return '<i class="material-icons status-inactive">close</i>';
                        }
                    },
                    {
                        aTargets: [4],
                        mData: "Actions",
                        mRender: function () {
                            return '<a href="javascript:void(0)" class="edit-master-value"><i class="material-icons edit-icon">edit</i></a>';
                        }
                    }
                ]
            });

            $('#tblMasterValues').css("width", "100%");
            $('select').formSelect();
            $('select[name="tblMasterValues_length"]').formSelect();
            $("select[required]").css({
                display: "block",
                position: 'absolute',
                visibility: 'hidden'
            });

            $(document).on('change', '#ddlMasterKeys', function () {
                var selectedKey = $('#ddlMasterKeys option:selected').text();
                table.ajax.url('@Url.Action("MasterValuesByKey", "MasterData")' + '?key=' + selectedKey);
                table.ajax.reload();
            });

            $(document).on("click", ".reset", function () {
                $('#formMasterValue')[0].reset();
                $('#IsEdit').val('False');

                $('#MasterValueInContext_RowKey').val('');
                $('#MasterValueInContext_PartitionKey').val('');
                $('#Input_MasterValue_RowKey').val('');
                $('#MasterValueInContext_Name').val('');
                $('#MasterValueInContext_IsActive').prop('checked', false);

                $('#Select_MasterValueInContext_PartitionKey').formSelect('destroy');
                $('#Select_MasterValueInContext_PartitionKey').removeAttr('disabled');
                $('#Select_MasterValueInContext_PartitionKey').val('');
                $('#Select_MasterValueInContext_PartitionKey').formSelect();

                $('.btnSubmit').html('Create <i class="material-icons right">send</i>');
                $('.validation-summary-valid').find('ul').html('');
                M.updateTextFields();
            });

            $(document).on('click', '.edit-master-value', function () {
                var user = $('#tblMasterValues').DataTable().row($(this).parents('tr')).data();

                $('#IsEdit').val('True');

                $('#MasterValueInContext_RowKey').val(user["RowKey"]);
                $('#Input_MasterValue_RowKey').val(user["RowKey"]);

                $('#MasterValueInContext_PartitionKey').val(user["PartitionKey"]);

                $('#Select_MasterValueInContext_PartitionKey').formSelect('destroy');
                $('#Select_MasterValueInContext_PartitionKey option').prop('selected', false);
                $('#Select_MasterValueInContext_PartitionKey option:contains(' + user['PartitionKey'] + ')').prop('selected', true);
                $('#Select_MasterValueInContext_PartitionKey').attr('disabled', 'disabled');
                $('#Select_MasterValueInContext_PartitionKey').formSelect();

                $('.select-wrapper').removeClass('valid');

                $('#MasterValueInContext_Name').val(user["Name"]);
                $('#MasterValueInContext_Name').addClass('valid');

                $('#MasterValueInContext_IsActive').prop('checked', user["IsActive"] === true);

                $('.btnSubmit').html('Save <i class="material-icons right">send</i>');
                M.updateTextFields();
            });

            $(document).on('click', '.btnSubmit', function () {
                var form = $("#formMasterValue");

                if ($(form).valid()) {
                    var masterData = new Object();
                    masterData.Name = $('#MasterValueInContext_Name').val();
                    masterData.PartitionKey = $('#Select_MasterValueInContext_PartitionKey option:selected').text();
                    masterData.IsActive = $('#MasterValueInContext_IsActive').is(':checked');

                    if ($('#IsEdit').val() === 'True') {
                        masterData.RowKey = $('#MasterValueInContext_RowKey').val();
                    }

                    $.post('@Url.Action("MasterValues", "MasterData")',
                        { masterValue: masterData, isEdit: $('#IsEdit').val() },
                        function () {
                            table.ajax.url('@Url.Action("MasterValuesByKey", "MasterData")' + '?key=' + $('#ddlMasterKeys option:selected').text());
                            table.ajax.reload();
                        }
                    );

                    $('.reset').click();
                    $('.select-wrapper').removeClass('valid');
                }
            });

            $('.modal').modal();

            $(document).on('click', '.btnUpload', function () {
                var fileUpload = $("#files").get(0);
                var files = fileUpload.files;
                var data = new FormData();

                $.each(files, function (i) {
                    data.append(files[i].name, files[i]);
                });

                $(".progress").removeClass("hide");

                $.ajax({
                    type: "POST",
                    url: "/Configuration/MasterData/UploadExcel",
                    contentType: false,
                    processData: false,
                    data: data,
                    success: function (message) {
                        $(".progress").addClass("hide");

                        if (message.Success) {
                            window.location.reload();
                        }

                        if (message.Error) {
                            $(".divErrors").removeClass("hide");
                            $(".errors").html(message.Text);
                        }
                    },
                    error: function () { }
                });
            });
        });
    </script>
}