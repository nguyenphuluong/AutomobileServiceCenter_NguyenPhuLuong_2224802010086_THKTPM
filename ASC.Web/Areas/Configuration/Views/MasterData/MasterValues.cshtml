@model ASC.Web.Areas.Configuration.Models.MasterValuesViewModel
@{
    Layout = "_SecureLayout";
}

<div class="master-page">
    <div class="master-card z-depth-1">
        <div class="master-card-header">
            <h5>Master Values</h5>
        </div>

        <div class="master-card-body">
            <div class="row top-tools-row">
                <div class="input-field col s12 m4">
                    <select id="ddlMasterKeys">
                        <option value="">--All--</option>
                        @if (ViewBag.MasterKeys != null)
                        {
                            foreach (var key in ViewBag.MasterKeys)
                            {
                                <option value="@key.PartitionKey">@key.PartitionKey</option>
                            }
                        }
                    </select>
                    <label>Partition Key</label>
                </div>

                <div class="col s12 m8 right-align export-zone">
                    <a class="btn-flat modal-trigger" href="#modal1" title="Upload Excel">
                        <i class="material-icons">upload_file</i>
                    </a>
                </div>
            </div>

            <table class="highlight centered" id="tblMasterValues">
                <thead>
                    <tr>
                        <th>Row Key</th>
                        <th>Partition Key</th>
                        <th>Name</th>
                        <th>Is Active</th>
                        <th>Edit</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>

    <div class="master-card z-depth-1">
        <div class="master-card-header">
            <h5>Master Value Details</h5>
        </div>

        <div class="master-card-body">
            <form id="formMasterValue">
                @Html.AntiForgeryToken()

                <input type="hidden" id="IsEdit" value="False" />
                <input type="hidden" id="MasterValue_RowKey" />
                <input type="hidden" id="MasterValue_PartitionKey" />

                <div class="row form-row">
                    <div class="input-field col s12 m4">
                        <input id="Input_MasterValue_RowKey" type="text" disabled />
                        <label for="Input_MasterValue_RowKey" class="active">RowKey</label>
                    </div>

                    <!-- CREATE MODE: chọn Partition Key bằng dropdown -->
                    <div class="input-field col s12 m4" id="CreatePartitionWrapper">
                        <select id="Create_MasterValue_PartitionKey">
                            <option value="">--Select--</option>
                            @if (ViewBag.MasterKeys != null)
                            {
                                foreach (var key in ViewBag.MasterKeys)
                                {
                                    <option value="@key.PartitionKey">@key.PartitionKey</option>
                                }
                            }
                        </select>
                        <label>Partition Key</label>
                    </div>

                    <!-- EDIT MODE: hiện Partition Key bằng input readonly -->
                    <div class="input-field col s12 m4 hide" id="EditPartitionWrapper">
                        <input id="Edit_MasterValue_PartitionKey" type="text" readonly />
                        <label for="Edit_MasterValue_PartitionKey" class="active">Partition Key</label>
                    </div>

                    <div class="input-field col s12 m4">
                        <input id="MasterValue_Name" class="validate" required />
                        <label for="MasterValue_Name" class="active">Name</label>
                    </div>
                </div>

                <div class="row form-row">
                    <div class="col s12 m4 switch-wrap">
                        <span class="switch-text">Is Active</span>
                        <div class="switch">
                            <label>
                                <input id="MasterValue_IsActive" type="checkbox" checked />
                                <span class="lever"></span>
                            </label>
                        </div>
                    </div>

                    <div class="col s12 m8 right-align">
                        <button class="btn waves-effect waves-light teal btnSubmit" type="button">
                            Create
                            <i class="material-icons right">send</i>
                        </button>

                        <button class="btn waves-effect waves-light red lighten-1 reset" type="button">
                            Reset
                        </button>
                    </div>

                    <div class="col s12 validation-wrap"></div>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="modal1" class="modal modal-fixed-footer">
    <div class="modal-content">
        <h4>Upload Excel</h4>
        <p>Upload the Excel file that contains all the master values.</p>

        <div class="row hide divErrors">
            <div class="col s12">
                <div class="card-panel red lighten-1">
                    <span class="white-text errors"></span>
                </div>
            </div>
        </div>

        <div class="progress hide">
            <div class="indeterminate"></div>
        </div>

        <form asp-action="UploadExcel" asp-controller="MasterData" method="post">
            @Html.AntiForgeryToken()

            <div class="file-field input-field">
                <div class="btn teal">
                    <span>File</span>
                    <input type="file" id="files" accept=".xlsx,.xls" />
                </div>

                <div class="file-path-wrapper">
                    <input class="file-path validate" type="text">
                </div>

                <div class="input-field row right">
                    <button class="btn waves-effect waves-light btnUpload" type="button">
                        Upload
                        <i class="material-icons right">send</i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var token = $('input[name="__RequestVerificationToken"]').first().val();

            function normalizeBool(value) {
                return value === true || value === "true" || value === "True";
            }

            function getCurrentFilterKey() {
                var selectedValue = $('#ddlMasterKeys').val();
                return selectedValue ? selectedValue.trim() : "";
            }

            var table = $('#tblMasterValues').DataTable({
                ajax: {
                    url: '@Url.Action("MasterValuesByKey", "MasterData", new { area = "Configuration" })',
                    type: 'GET',
                    dataSrc: 'data',
                    error: function (xhr) {
                        console.log("DATATABLE ERROR:", xhr);
                    }
                },
                pageLength: 3,
                lengthMenu: [[3, 5, 10, -1], [3, 5, 10, 'All']],
                columns: [
                    {
                        data: null,
                        render: function (data) {
                            return data.rowKey || data.RowKey || '';
                        }
                    },
                    {
                        data: null,
                        render: function (data) {
                            return data.partitionKey || data.PartitionKey || '';
                        }
                    },
                    {
                        data: null,
                        render: function (data) {
                            return data.name || data.Name || '';
                        }
                    },
                    {
                        data: null,
                        render: function (data) {
                            var isActive = data.isActive;

                            if (isActive === undefined) {
                                isActive = data.IsActive;
                            }

                            if (normalizeBool(isActive)) {
                                return '<i class="material-icons status-active">check</i>';
                            }

                            return '<i class="material-icons status-inactive">close</i>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function () {
                            return '<a href="javascript:void(0)" class="edit-master-value"><i class="material-icons edit-icon">edit</i></a>';
                        }
                    }
                ]
            });

            function reloadTable() {
                var selectedKey = getCurrentFilterKey();

                table.ajax.url(
                    '@Url.Action("MasterValuesByKey", "MasterData", new { area = "Configuration" })'
                    + '?key=' + encodeURIComponent(selectedKey)
                );

                table.ajax.reload(null, false);
            }

            function setCreateMode() {
                $('#IsEdit').val('False');

                $('#CreatePartitionWrapper').removeClass('hide');
                $('#EditPartitionWrapper').addClass('hide');

                $('#Create_MasterValue_PartitionKey').formSelect('destroy');
                $('#Create_MasterValue_PartitionKey').removeAttr('disabled');
                $('#Create_MasterValue_PartitionKey').val('');
                $('#Create_MasterValue_PartitionKey').formSelect();

                $('.btnSubmit').html('Create <i class="material-icons right">send</i>');
            }

            function setEditMode() {
                $('#IsEdit').val('True');

                $('#CreatePartitionWrapper').addClass('hide');
                $('#EditPartitionWrapper').removeClass('hide');

                $('#Create_MasterValue_PartitionKey').formSelect('destroy');
                $('#Create_MasterValue_PartitionKey').attr('disabled', 'disabled');
                $('#Create_MasterValue_PartitionKey').formSelect();

                $('.btnSubmit').html('Save <i class="material-icons right">send</i>');
            }

            function resetMasterValueForm() {
                $('#MasterValue_RowKey').val('');
                $('#MasterValue_PartitionKey').val('');
                $('#Input_MasterValue_RowKey').val('');
                $('#Edit_MasterValue_PartitionKey').val('');
                $('#MasterValue_Name').val('');
                $('#MasterValue_IsActive').prop('checked', true);
                $('.validation-wrap').html('');

                setCreateMode();
                M.updateTextFields();
            }

            $('#tblMasterValues').css("width", "100%");

            $('select').formSelect();
            $('select[name="tblMasterValues_length"]').formSelect();

            $('#MasterValue_IsActive').prop('checked', true);
            M.updateTextFields();

            $(document).on('change', '#ddlMasterKeys', function () {
                reloadTable();
            });

            $(document).on("click", ".reset", function () {
                resetMasterValueForm();
            });

            $(document).on('click', '.edit-master-value', function () {
                var tr = $(this).closest('tr');

                if (tr.hasClass('child')) {
                    tr = tr.prev();
                }

                var rowData = table.row(tr).data();

                if (!rowData) {
                    alert("Không lấy được dữ liệu dòng đang chọn.");
                    return;
                }

                var rowKey = rowData.rowKey || rowData.RowKey;
                var partitionKey = rowData.partitionKey || rowData.PartitionKey;
                var name = rowData.name || rowData.Name;
                var isActive = rowData.isActive;

                if (isActive === undefined) {
                    isActive = rowData.IsActive;
                }

                console.log("EDIT MASTER VALUE:", {
                    rowKey: rowKey,
                    partitionKey: partitionKey,
                    name: name,
                    isActive: isActive
                });

                $('#MasterValue_RowKey').val(rowKey);
                $('#MasterValue_PartitionKey').val(partitionKey);
                $('#Input_MasterValue_RowKey').val(rowKey);
                $('#Edit_MasterValue_PartitionKey').val(partitionKey);
                $('#MasterValue_Name').val(name);
                $('#MasterValue_IsActive').prop('checked', normalizeBool(isActive));

                setEditMode();
                M.updateTextFields();
            });

            $(document).on('click', '.btnSubmit', function () {
                var isEdit = $('#IsEdit').val() === 'True';

                var rowKey = $('#MasterValue_RowKey').val();
                var partitionKey = "";

                if (isEdit) {
                    partitionKey = $('#MasterValue_PartitionKey').val();
                } else {
                    partitionKey = $('#Create_MasterValue_PartitionKey').val();
                }

                var name = $('#MasterValue_Name').val().trim();
                var isActive = $('#MasterValue_IsActive').is(':checked');

                if (!partitionKey) {
                    alert("Vui lòng chọn Partition Key.");
                    return;
                }

                if (!name) {
                    alert("Name không được để trống.");
                    return;
                }

                var postData = {
                    __RequestVerificationToken: token,
                    isEdit: isEdit,
                    rowKey: rowKey,
                    partitionKey: partitionKey,
                    name: name,
                    isActive: isActive
                };

                console.log("POST MASTER VALUE:", postData);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SaveMasterValue", "MasterData", new { area = "Configuration" })',
                    data: postData,
                    success: function (response) {
                        console.log("SAVE MASTER VALUE RESPONSE:", response);

                        var ok = response && (response.success === true || response.Success === true);

                        if (!ok) {
                            alert((response && (response.text || response.Text)) || "Lưu Master Value thất bại.");
                            return;
                        }

                        alert((response && (response.text || response.Text)) || "Lưu Master Value thành công.");

                        reloadTable();
                        resetMasterValueForm();
                    },
                    error: function (xhr) {
                        console.log("SAVE MASTER VALUE ERROR:", xhr);

                        var errorText =
                            "Lỗi server khi lưu Master Value.\n" +
                            "Status: " + xhr.status + "\n" +
                            "Response: " + (xhr.responseText || "Không có responseText");

                        alert(errorText);
                    }
                });
            });

            $('.modal').modal();

            $(document).on('click', '.btnUpload', function () {
                var fileUpload = $("#files").get(0);
                var files = fileUpload.files;

                if (!files || files.length === 0) {
                    $(".divErrors").removeClass("hide");
                    $(".errors").html("Chưa chọn file Excel.");
                    return;
                }

                var data = new FormData();
                data.append("file", files[0]);

                $(".divErrors").addClass("hide");
                $(".errors").html("");
                $(".progress").removeClass("hide");

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("UploadExcel", "MasterData", new { area = "Configuration" })',
                    contentType: false,
                    processData: false,
                    data: data,

                    success: function (message) {
                        $(".progress").addClass("hide");

                        var isSuccess = message && (message.success === true || message.Success === true);
                        var text = "";

                        if (message) {
                            text = message.text || message.Text || JSON.stringify(message);
                        }

                        if (isSuccess) {
                            alert(text || "Upload thành công.");

                            reloadTable();

                            var modalElement = document.getElementById('modal1');
                            var modalInstance = M.Modal.getInstance(modalElement);

                            if (modalInstance) {
                                modalInstance.close();
                            }

                            $("#files").val("");
                            $(".file-path").val("");

                            return;
                        }

                        $(".divErrors").removeClass("hide");
                        $(".errors").html(text || "Upload không thành công nhưng server không trả lỗi rõ.");
                    },

                    error: function (xhr) {
                        $(".progress").addClass("hide");
                        $(".divErrors").removeClass("hide");

                        var errorText = "Lỗi upload.";

                        if (xhr.responseJSON) {
                            errorText = xhr.responseJSON.text || xhr.responseJSON.Text || JSON.stringify(xhr.responseJSON);
                        } else if (xhr.responseText) {
                            errorText = xhr.responseText;
                        }

                        $(".errors").html(errorText);
                        alert(errorText);
                    }
                });
            });

            resetMasterValueForm();
        });
    </script>
}