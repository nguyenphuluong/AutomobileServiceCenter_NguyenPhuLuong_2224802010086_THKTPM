@model ASC.Web.Areas.Configuration.Models.MasterKeysViewModel
@{
    Layout = "_SecureLayout";
}

<div class="master-page">
    <div class="master-card z-depth-1">
        <div class="master-card-header">
            <h5>Master Keys</h5>
        </div>

        <div class="master-card-body">
            <table class="highlight centered" id="tblMasterKeys">
                <thead>
                    <tr>
                        <th>Row Key</th>
                        <th>Name</th>
                        <th>Is Active</th>
                        <th>Edit</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.MasterKeys != null)
                    {
                        foreach (var masterKey in Model.MasterKeys)
                        {
                            <tr data-rowkey="@masterKey.RowKey"
                                data-partitionkey="@masterKey.PartitionKey"
                                data-name="@masterKey.Name"
                                data-isactive="@(masterKey.IsActive ? "true" : "false")">

                                <td>@masterKey.RowKey</td>
                                <td>@masterKey.Name</td>
                                <td>
                                    @if (masterKey.IsActive)
                                    {
                                        <i class="material-icons status-active">check</i>
                                    }
                                    else
                                    {
                                        <i class="material-icons status-inactive">close</i>
                                    }
                                </td>
                                <td>
                                    <a href="javascript:void(0)" class="edit-master-key">
                                        <i class="material-icons edit-icon">edit</i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="master-card z-depth-1">
        <div class="master-card-header">
            <h5>Master Key Details</h5>
        </div>

        <div class="master-card-body">
            <form id="formMasterKeys">
                @Html.AntiForgeryToken()

                <input type="hidden" id="IsEdit" value="False" />
                <input type="hidden" id="MasterKey_RowKey" />
                <input type="hidden" id="MasterKey_PartitionKey" />

                <div class="row form-row">
                    <div class="input-field col s12 m5">
                        <input id="Input_MasterKey_RowKey" type="text" disabled />
                        <label for="Input_MasterKey_RowKey" class="active">RowKey</label>
                    </div>

                    <div class="input-field col s12 m4">
                        <input id="MasterKey_Name" class="validate" required />
                        <label for="MasterKey_Name" class="active">Name</label>
                    </div>

                    <div class="col s12 m3 switch-wrap">
                        <span class="switch-text">Is Active</span>
                        <div class="switch">
                            <label>
                                <input id="MasterKey_IsActive" type="checkbox" checked />
                                <span class="lever"></span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="row action-row">
                    <div class="col s12 right-align">
                        <button class="btn waves-effect waves-light teal btnSubmit" type="button">
                            Create
                            <i class="material-icons right">send</i>
                        </button>

                        <button class="btn waves-effect waves-light red lighten-1 reset" type="button">
                            Reset
                        </button>
                    </div>

                    <div class="col s12 validation-wrap"></div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var token = $('input[name="__RequestVerificationToken"]').first().val();

            var table = $('#tblMasterKeys').DataTable({
                pageLength: 3,
                lengthMenu: [[3, 5, 10, -1], [3, 5, 10, 'All']],
                columnDefs: [
                    { targets: [2, 3], orderable: false }
                ]
            });

            $('#tblMasterKeys').css("width", "100%");
            $('select[name="tblMasterKeys_length"]').formSelect();

            function normalizeBool(value) {
                return value === true || value === "true" || value === "True";
            }

            function resetMasterKeyForm() {
                $('#IsEdit').val('False');
                $('#MasterKey_RowKey').val('');
                $('#MasterKey_PartitionKey').val('');
                $('#Input_MasterKey_RowKey').val('');
                $('#MasterKey_Name').val('');
                $('#MasterKey_IsActive').prop('checked', true);

                $('.btnSubmit').html('Create <i class="material-icons right">send</i>');
                $('.validation-wrap').html('');

                M.updateTextFields();
            }

            resetMasterKeyForm();

            $(document).on('click', '.reset', function () {
                resetMasterKeyForm();
            });

            $(document).on('click', '.edit-master-key', function () {
                var tr = $(this).closest('tr');

                if (tr.hasClass('child')) {
                    tr = tr.prev();
                }

                var rowKey = tr.attr('data-rowkey');
                var partitionKey = tr.attr('data-partitionkey');
                var name = tr.attr('data-name');
                var isActive = normalizeBool(tr.attr('data-isactive'));

                console.log("EDIT MASTER KEY:", {
                    rowKey: rowKey,
                    partitionKey: partitionKey,
                    name: name,
                    isActive: isActive
                });

                $('#IsEdit').val('True');
                $('#MasterKey_RowKey').val(rowKey);
                $('#MasterKey_PartitionKey').val(partitionKey);
                $('#Input_MasterKey_RowKey').val(rowKey);
                $('#MasterKey_Name').val(name);
                $('#MasterKey_IsActive').prop('checked', isActive);

                $('.btnSubmit').html('Save <i class="material-icons right">send</i>');

                M.updateTextFields();
            });

            $(document).on('click', '.btnSubmit', function () {
                var isEdit = $('#IsEdit').val() === 'True';
                var rowKey = $('#MasterKey_RowKey').val();
                var partitionKey = $('#MasterKey_PartitionKey').val();
                var name = $('#MasterKey_Name').val().trim();
                var isActive = $('#MasterKey_IsActive').is(':checked');

                if (!name) {
                    alert("Name không được để trống.");
                    return;
                }

                var postData = {
                    __RequestVerificationToken: token,
                    isEdit: isEdit,
                    rowKey: rowKey,
                    partitionKey: partitionKey,
                    name: name,
                    isActive: isActive
                };

                console.log("POST MASTER KEY:", postData);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SaveMasterKey", "MasterData", new { area = "Configuration" })',
                    data: postData,
                    success: function (response) {
                        console.log("SAVE MASTER KEY RESPONSE:", response);

                        var ok = response && (response.success === true || response.Success === true);

                        if (!ok) {
                            alert((response && (response.text || response.Text)) || "Lưu Master Key thất bại.");
                            return;
                        }

                        alert((response && (response.text || response.Text)) || "Lưu Master Key thành công.");
                        window.location.reload();
                    },
                    error: function (xhr) {
                        console.log("SAVE MASTER KEY ERROR:", xhr);

                        var errorText =
                            "Lỗi server khi lưu Master Key.\n" +
                            "Status: " + xhr.status + "\n" +
                            "Response: " + (xhr.responseText || "Không có responseText");

                        alert(errorText);
                    }
                });
            });
        });
    </script>
}