@model ASC.Web.Areas.Configuration.Models.MasterKeysViewModel
@{
    Layout = "_SecureLayout";
}

<div class="master-page">
    <!-- LIST -->
    <div class="master-card z-depth-1">
        <div class="master-card-header">
            <h5>Master Keys</h5>
        </div>

        <div class="master-card-body">
            <table class="highlight centered" id="tblMasterKeys">
                <thead>
                    <tr>
                        <th>Row Key</th>
                        <th>Partition Key</th>
                        <th>Name</th>
                        <th>IsActiveRaw</th>
                        <th>Is Active</th>
                        <th>Edit</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.MasterKeys != null)
                    {
                        @foreach (var masterKey in Model.MasterKeys)
                        {
                            <tr>
                                <td>@masterKey.RowKey</td>
                                <td>@masterKey.PartitionKey</td>
                                <td>@masterKey.Name</td>
                                <td>@masterKey.IsActive</td>
                                <td>
                                    @if (masterKey.IsActive)
                                    {
                                        <i class="material-icons status-active">check</i>
                                    }
                                    else
                                    {
                                        <i class="material-icons status-inactive">close</i>
                                    }
                                </td>
                                <td>
                                    <a href="javascript:void(0)" class="edit-master-key">
                                        <i class="material-icons edit-icon">edit</i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- DETAILS -->
    <div class="master-card z-depth-1">
        <div class="master-card-header">
            <h5>Master Key Details</h5>
        </div>

        <div class="master-card-body">
            <form asp-controller="MasterData" asp-action="MasterKeys" method="post" id="formMasterKeys">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="IsEdit" />
                <input type="hidden" asp-for="MasterKeyInContext.RowKey" />
                <input type="hidden" asp-for="MasterKeyInContext.PartitionKey" />

                <div class="row form-row">
                    <div class="input-field col s12 m5">
                        <input id="Input_MasterKey_RowKey" type="text" disabled />
                        <label for="Input_MasterKey_RowKey" class="active">RowKey</label>
                    </div>

                    <div class="input-field col s12 m4">
                        <input asp-for="MasterKeyInContext.Name" id="MasterKeyInContext_Name" class="validate" />
                        <label asp-for="MasterKeyInContext.Name">Name</label>
                    </div>

                    <div class="col s12 m3 switch-wrap">
                        <span class="switch-text">Is Active</span>
                        <div class="switch">
                            <label>
                                <input asp-for="MasterKeyInContext.IsActive" type="checkbox" />
                                <span class="lever"></span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="row action-row">
                    <div class="col s12 right-align">
                        <button class="btn waves-effect waves-light teal btnSubmit" type="submit">
                            Create
                            <i class="material-icons right">send</i>
                        </button>

                        <button class="btn waves-effect waves-light red lighten-1 reset" type="button">
                            Reset
                        </button>
                    </div>

                    <div class="col s12 validation-wrap" asp-validation-summary="All"></div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#tblMasterKeys').DataTable({
                pageLength: 3,
                lengthMenu: [[3, 5, 10, -1], [3, 5, 10, 'All']],
                columnDefs: [
                    { targets: [1, 3], visible: false, searchable: false },
                    { targets: [4, 5], orderable: false }
                ]
            });

            $('#tblMasterKeys').css("width", "100%");
            $('select[name="tblMasterKeys_length"]').formSelect();

            $(document).on('click', '.reset', function () {
                $('#formMasterKeys')[0].reset();

                $('#IsEdit').val('False');
                $('#MasterKeyInContext_RowKey').val('');
                $('#MasterKeyInContext_PartitionKey').val('');
                $('#Input_MasterKey_RowKey').val('');
                $('#MasterKeyInContext_Name').val('');
                $('#MasterKeyInContext_IsActive').prop('checked', false);

                $('.btnSubmit').html('Create <i class="material-icons right">send</i>');
                $('.validation-wrap ul').html('');
                $('.validation-summary-errors ul').html('');
                $('.validation-summary-valid ul').html('');

                M.updateTextFields();
            });

            $(document).on('click', '.edit-master-key', function () {
                var row = table.row($(this).closest('tr')).data();

                $('#IsEdit').val('True');

                // 0 = RowKey, 1 = PartitionKey, 2 = Name, 3 = IsActive raw
                $('#MasterKeyInContext_RowKey').val(row[0]);
                $('#Input_MasterKey_RowKey').val(row[0]);
                $('#MasterKeyInContext_PartitionKey').val(row[1]);
                $('#MasterKeyInContext_Name').val(row[2]);
                $('#MasterKeyInContext_IsActive').prop('checked', row[3] === 'True' || row[3] === true);

                $('.btnSubmit').html('Save <i class="material-icons right">send</i>');
                M.updateTextFields();
            });
        });
    </script>
}