@model IEnumerable<ASC.Model.Models.ServiceRequest>

@{
    var isAudit = ViewBag.IsAudit != null && (bool)ViewBag.IsAudit;
    var sectionName = ViewBag.SectionName ?? "Service Requests";
    var tableId = ViewBag.Id ?? "tblServiceRequests";
}

<div class="row"></div>

<div class="row padding-top-20px">
    <div class="row z-depth-3">
        <div class="section white-text padding-left-10px blue-grey lighten-1">
            <h5>@sectionName</h5>
        </div>

        <div id="divider"></div>

        <div class="col s12 padding-bottom-15px">
            <table class="highlight centered tblServiceRequests" id="@tableId">
                <thead>
                    <tr>
                        <th data-field="RowKey">RowKey</th>
                        <th data-field="PartitionKey">PartitionKey</th>
                        <th data-field="User">User</th>
                        <th data-field="Status">Status</th>
                        <th data-field="RequestedDate">Requested Date</th>
                        <th data-field="ServiceEngineer">Service Engineer</th>

                        @if (isAudit)
                        {
                            <th data-field="RequestedServices">Requested Services</th>
                        }

                        <th data-field="Actions">View</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var serviceRequest in Model)
                        {
                            var userText = serviceRequest.PartitionKey;

                            if (!string.IsNullOrWhiteSpace(serviceRequest.PartitionKey)
                            && serviceRequest.PartitionKey.Contains("-"))
                            {
                                userText = serviceRequest.PartitionKey.Split(new char[] { '-' })[0];
                            }

                            var status = serviceRequest.Status ?? "";
                            var statusClass = "blue-grey lighten-1";

                            switch (status)
                            {
                                case "New":
                                case "Initiated":
                                case "InProgress":
                                case "Completed":
                                    statusClass = "teal lighten-1";
                                    break;

                                case "RequestForInformation":
                                case "Pending":
                                case "Denied":
                                    statusClass = "red lighten-1";
                                    break;

                                case "PendingCustomerApproval":
                                    statusClass = "orange lighten-1";
                                    break;

                                default:
                                    statusClass = "blue-grey lighten-1";
                                    break;
                            }

                            var requestedDateText = serviceRequest.RequestedDate == null
                            ? ""
                            : serviceRequest.RequestedDate.Value.ToString("dd/MM/yyyy");

                            var serviceEngineerText = string.IsNullOrWhiteSpace(serviceRequest.ServiceEngineer)
                            ? "Not Assigned"
                            : serviceRequest.ServiceEngineer;

                            var requestedServicesText = string.IsNullOrWhiteSpace(serviceRequest.RequestedServices)
                            ? string.Empty
                            : serviceRequest.RequestedServices.Length > 50
                            ? string.Format("{0}...", serviceRequest.RequestedServices.Substring(0, 50))
                            : serviceRequest.RequestedServices;

                            <tr>
                                <td>@serviceRequest.RowKey</td>
                                <td>@serviceRequest.PartitionKey</td>
                                <td>@userText</td>

                                <td>
                                    <div class="white-text @statusClass center-align">
                                        <span>@status</span>
                                    </div>
                                </td>

                                <td>@requestedDateText</td>
                                <td>@serviceEngineerText</td>

                                @if (isAudit)
                                {
                                    <td title="@serviceRequest.RequestedServices">
                                        @requestedServicesText
                                    </td>
                                }

                                <td>
                                    <i class="small material-icons view cursor-hand">pageview</i>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>