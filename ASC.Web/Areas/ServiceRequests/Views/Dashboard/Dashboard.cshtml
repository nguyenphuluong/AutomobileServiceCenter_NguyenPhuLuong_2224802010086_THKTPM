@model ASC.Web.Areas.ServiceRequests.Models.DashboardViewModel

@{
    Layout = "_SecureLayout";
    ViewData["Title"] = "Service Requests Dashboard";
}

<style>
    .chat-btn {
        background-color: #26a69a;
    }

        .chat-btn:hover {
            background-color: #2bbbad;
        }
</style>

<div class="row padding-left-20px padding-right-20px">
    <div class="col s12">
        <div class="card">
            <div class="card-content">

                <span class="card-title">
                    Service Requests Dashboard
                </span>

                <table id="tblServiceRequests" class="striped highlight">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Status</th>
                            <th>Requested Date</th>
                            <th>Service Engineer</th>
                            <th>Chat</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.ServiceRequests)
                        {
                            <tr>
                                <td>@item.PartitionKey</td>

                                <td>@item.Status</td>

                                <td>
                                    @(item.RequestedDate?.ToString("dd/MM/yyyy"))
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.ServiceEngineer)
                                                                    ? "Not Assigned"
                                                                    : item.ServiceEngineer)
                            </td>

                                <td>
                                    <a asp-area="ServiceRequests"
                                       asp-controller="ServiceRequest"
                                       asp-action="Details"
                                       asp-route-id="@item.RowKey"
                                       class="btn-small waves-effect waves-light chat-btn">
                                        Chat
                                    </a>
                                </td>
                            </tr>
                                                }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.DataTable) {
                $('#tblServiceRequests').DataTable({
                    pageLength: 3,
                    lengthMenu: [[3, 5, 10, -1], [3, 5, 10, 'All']],
                    ordering: false
                });

                if ($('select[name="tblServiceRequests_length"]').length > 0) {
                    $('select[name="tblServiceRequests_length"]').material_select
                        ? $('select[name="tblServiceRequests_length"]').material_select()
                        : $('select[name="tblServiceRequests_length"]').formSelect();
                }
            }
        });
    </script>
}